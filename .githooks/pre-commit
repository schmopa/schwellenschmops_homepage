#!/bin/sh
# SCHWELLENSCHMOPS — pre-commit
#
# Läuft bei jedem `git commit` (aktiviert über `git config core.hooksPath
# .githooks`, siehe README.md). Führt build.js aus und bricht den Commit
# ab, wenn sich dadurch noch etwas an den Root-HTML-Seiten ändert -- das
# würde bedeuten, dass der gestagte Stand nicht mehr zu partials/ passt
# (z.B. weil jemand direkt in einer HTML-Datei statt im Partial editiert
# hat, oder ein Cache-Buster in build.js geändert, aber build.js seither
# nicht mehr laufen gelassen wurde).

# Nur die tatsaechlich gestagten HTML-Dateien merken, BEVOR build.js
# laeuft -- sonst blockt der Hook auch wegen HTML-Dateien, die gerade
# gar nicht committet werden (z.B. andere, noch unfertige Edits im
# Working Tree). Nur wenn build.js eine STAGED Datei nach dem Staging
# noch veraendert, ist der gestagte Stand tatsaechlich veraltet.
staged_html=$(git diff --cached --name-only -- '*.html')

node build.js || exit 1

stale=""
for f in $staged_html; do
  if ! git diff --quiet -- "$f"; then
    stale="$stale $f"
  fi
done

if [ -n "$stale" ]; then
  echo "pre-commit: build.js hat folgende gestagte Datei(en) noch veraendert -- bitte pruefen und erneut 'git add' + committen:"
  echo "$stale"
  exit 1
fi

exit 0
