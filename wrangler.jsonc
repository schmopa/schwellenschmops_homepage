// Cloudflare Workers (Static Assets) — Hosting für schwellenschmops.at.
// Kein Build-Schritt: die gebauten HTML-Dateien liegen committed im Root
// (siehe build.js). Was NICHT veröffentlicht wird, steht in .assetsignore.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "schwellenschmops-homepage",
  "compatibility_date": "2026-10-01",
  // Domains hängen direkt am Worker; Cloudflare legt DNS + Zertifikat selbst an.
  // www → Apex-Weiterleitung läuft über eine Redirect Rule im Dashboard.
  "routes": [
    { "pattern": "schwellenschmops.at", "custom_domain": true },
    { "pattern": "www.schwellenschmops.at", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "html_handling": "none"
  }
}
